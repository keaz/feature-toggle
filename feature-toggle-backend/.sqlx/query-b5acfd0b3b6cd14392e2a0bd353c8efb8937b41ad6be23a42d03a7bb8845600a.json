{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT ui.user_id, p.slug AS provider_slug, ui.subject, ui.email, ui.last_login\n            FROM user_identities ui\n            JOIN sso_providers p ON p.id = ui.provider_id\n            WHERE ui.user_id = $1\n            ORDER BY p.slug, ui.subject\n            ",
